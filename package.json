{
  "name": "@zfyao666/opencode-gpt-usage",
  "version": "0.2.0",
  "private": true,
  "description": "AI subscription usage gauge with provider status for the opencode TUI (Claude Pro/Max, ChatGPT Plus/Pro) — shows ▓▓▓░░░ 36% · 0h 39m and a ! marker during incidents.",
  "type": "module",
  "license": "MIT",
  "author": "satas20 <ata.ayyildiz@outlook.com>",
  "keywords": ["opencode", "tui", "plugin", "usage", "quota", "claude", "chatgpt", "codex", "status", "statusbar", "incident"],
  "homepage": "https://github.com/zfyao666/opencode-gpt-usage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zfyao666/opencode-gpt-usage.git"
  },
  "bugs": {
    "url": "https://github.com/zfyao666/opencode-gpt-usage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./tui": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "opencode": ">=1.17"
  },
  "scripts": {
    "build": "bun run build.ts && tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": ">=1.17",
    "@opentui/solid": "^0.4.3",
    "@types/node": "^26.1.1",
    "solid-js": "*",
    "typescript": "^5"
  }
}
